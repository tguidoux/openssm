load("//tools/rules/golang:defs.bzl", "openssm_go_binary", "openssm_go_image", "openssm_go_library")

openssm_go_library(
    name = "go_default_library",
    srcs = ["main.go"],
    importpath = "github.com/tguidoux/openssm/apps/go/agent",
    visibility = ["//visibility:private"],
    deps = [
        "//pkgs/v1/agent:go_default_library",
        "//pkgs/v1/logger:go_default_library",
    ],
)

openssm_go_binary(
    name = "openssm-agent",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

# The agent image is Ubuntu-based (not distroless) so commands and sessions
# have a real shell and common tools available.
openssm_go_image(
    name = "openssm_agent_image",
    binary = ":openssm-agent",
    image_tags = ["openssm-agent:latest"],
    registry = "ghcr.io/tguidoux/openssm",
)
