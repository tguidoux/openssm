# OpenSSM Docker image — no authentication
#
# Usage:
#   docker build -f examples/docker/Dockerfile.no-auth -t openssm-no-auth examples/docker
#   docker run -p 9330:9330 -p 9331:9331 -p 9332:9332 openssm-no-auth
#
# Ports:
#   9330 — SSM API, agent API and Session Manager data channels
#   9331 — Web UI
#   9332 — Prometheus metrics
#
# See: examples/README.md

FROM ghcr.io/tguidoux/openssm/openssm-server:latest

COPY config.no-auth.yaml /etc/openssm/config.yaml

ENV CONFIG_PATH=/etc/openssm/config.yaml

EXPOSE 9330 9331 9332
